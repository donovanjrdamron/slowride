{% doc %}
  @prompt
    A hero section that i can insert my own image for and will show under my header. I want it to be completely editable with the option to choose my own aspect ratio for desktop and for mobile using the same image, please make the padding adjustable functional
    , when i adjust the padding it moves the content on the inside of the section. i want it to adjust the padding on the outside of the section so that when i adjust the paddings all to 0 there is no gaps around the section content, i want to be able to select a separate image for desktop and mobile. i also want to be able to have a choice to use a video from shopify files and change the video for mobile and desktop so i can use seperate videos from each, i want to be able to select a video from shopify files not a url, Liquid error (temp/ai_gen_block_2285209 line 177): wrong number of arguments (given 3, expected 2)
    , Make it so i can add a link to the entire block 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
  }

  .ai-hero-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .ai-hero-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
  }

  .ai-hero-media-wrapper-{{ ai_gen_id }}--desktop {
    padding-bottom: {{ block.settings.aspect_ratio_desktop }}%;
  }

  .ai-hero-media-wrapper-{{ ai_gen_id }}--mobile {
    padding-bottom: {{ block.settings.aspect_ratio_mobile }}%;
  }

  .ai-hero-media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-desktop-media-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-mobile-media-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    {% assign _op = block.settings.overlay_opacity | divided_by: 100.0 %}
    {% assign _strength = block.settings.gradient_strength | divided_by: 100.0 %}
    {% if block.settings.overlay_style == 'gradient' %}
      background: linear-gradient(
        {{ block.settings.gradient_direction }},
        {{ block.settings.overlay_color | color_modify: 'alpha', _op }} 0%,
        {{ block.settings.overlay_color | color_modify: 'alpha', _strength }} 100%
      );
    {% elsif block.settings.overlay_style == 'solid' %}
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ _op }};
    {% endif %}
  }

  .ai-hero-content-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_align }};
    align-items: {{ block.settings.content_horizontal_align }};
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_align }};
    color: {{ block.settings.text_color }};
    pointer-events: none;
    {% if block.settings.text_shadow %}
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
    {% endif %}
  }

  .ai-hero-content-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-hero-description-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  .ai-hero-button-{{ ai_gen_id }} {
    pointer-events: auto;
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border: 1px solid {{ block.settings.button_bg }};
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .ai-hero-button-{{ ai_gen_id }}:hover {
    background-color: transparent;
    color: {{ block.settings.button_bg }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
      padding-left: {{ block.settings.padding_left_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
    }

    .ai-hero-desktop-media-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-mobile-media-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }

    .ai-hero-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }
{% endstyle %}

<hero-section-{{ ai_gen_id }} class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank %}
    <a href="{{ block.settings.link }}" class="ai-hero-link-{{ ai_gen_id }}">
  {% endif %}
    <div class="ai-hero-container-{{ ai_gen_id }}">
      {% if block.settings.media_type == 'image' %}
        <div class="ai-hero-desktop-media-{{ ai_gen_id }}">
          <div class="ai-hero-media-wrapper-{{ ai_gen_id }} ai-hero-media-wrapper-{{ ai_gen_id }}--desktop">
            {% if block.settings.desktop_image %}
              <img
                src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
                srcset="{{ block.settings.desktop_image | image_url: width: 600 }} 600w,
                        {{ block.settings.desktop_image | image_url: width: 1200 }} 1200w,
                        {{ block.settings.desktop_image | image_url: width: 1800 }} 1800w,
                        {{ block.settings.desktop_image | image_url: width: 2400 }} 2400w"
                sizes="100vw"
                alt="{{ block.settings.desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.desktop_image.width }}"
                height="{{ block.settings.desktop_image.height }}"
                class="ai-hero-media-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                <div class="ai-hero-empty-state-{{ ai_gen_id }}">
                  Add a desktop image
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="ai-hero-mobile-media-{{ ai_gen_id }}">
          <div class="ai-hero-media-wrapper-{{ ai_gen_id }} ai-hero-media-wrapper-{{ ai_gen_id }}--mobile">
            {% if block.settings.mobile_image %}
              <img
                src="{{ block.settings.mobile_image | image_url: width: 800 }}"
                srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                        {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                        {{ block.settings.mobile_image | image_url: width: 800 }} 800w"
                sizes="100vw"
                alt="{{ block.settings.mobile_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.mobile_image.width }}"
                height="{{ block.settings.mobile_image.height }}"
                class="ai-hero-media-{{ ai_gen_id }}"
              >
            {% elsif block.settings.desktop_image %}
              <img
                src="{{ block.settings.desktop_image | image_url: width: 800 }}"
                srcset="{{ block.settings.desktop_image | image_url: width: 400 }} 400w,
                        {{ block.settings.desktop_image | image_url: width: 600 }} 600w,
                        {{ block.settings.desktop_image | image_url: width: 800 }} 800w"
                sizes="100vw"
                alt="{{ block.settings.desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.desktop_image.width }}"
                height="{{ block.settings.desktop_image.height }}"
                class="ai-hero-media-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                <div class="ai-hero-empty-state-{{ ai_gen_id }}">
                  Add a mobile image
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="ai-hero-desktop-media-{{ ai_gen_id }}">
          <div class="ai-hero-media-wrapper-{{ ai_gen_id }} ai-hero-media-wrapper-{{ ai_gen_id }}--desktop">
            {% if block.settings.desktop_video %}
              {% assign desktop_video_class = 'ai-hero-media-' | append: ai_gen_id %}
              {{ block.settings.desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: desktop_video_class }}
            {% else %}
              <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                <div class="ai-hero-empty-state-{{ ai_gen_id }}">
                  Add a desktop video
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="ai-hero-mobile-media-{{ ai_gen_id }}">
          <div class="ai-hero-media-wrapper-{{ ai_gen_id }} ai-hero-media-wrapper-{{ ai_gen_id }}--mobile">
            {% if block.settings.mobile_video %}
              {% assign mobile_video_class = 'ai-hero-media-' | append: ai_gen_id %}
              {{ block.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: mobile_video_class }}
            {% elsif block.settings.desktop_video %}
              {% assign mobile_video_class = 'ai-hero-media-' | append: ai_gen_id %}
              {{ block.settings.desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: mobile_video_class }}
            {% else %}
              <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                <div class="ai-hero-empty-state-{{ ai_gen_id }}">
                  Add a mobile video
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.overlay_style != 'none' %}
        <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.heading != blank or block.settings.description != blank or block.settings.button_label != blank %}
        <div class="ai-hero-content-{{ ai_gen_id }}">
          <div class="ai-hero-content-inner-{{ ai_gen_id }}">
            {% if block.settings.heading != blank %}
              <h2 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="ai-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="ai-hero-button-{{ ai_gen_id }}">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  {% if block.settings.link != blank %}
    </a>
  {% endif %}
</hero-section-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('video');
        this.videos.forEach(video => {
          video.play().catch(() => {});
        });
      }
    }

    customElements.define('hero-section-{{ ai_gen_id }}', HeroSection{{ ai_gen_id }});
  })();
</script>

