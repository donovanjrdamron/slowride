{% liquid
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1800, 2000, 2500, 3000, 3840'
  assign custom_bg = section.settings.background_color
  assign has_custom_bg = false
  if custom_bg != blank and custom_bg != 'rgba(0,0,0,0)'
    assign has_custom_bg = true
  endif
%}

<div
  class="section-background color-{{ section.settings.color_scheme }}"
  {% if has_custom_bg %}style="background-color: {{ custom_bg }};"{% endif %}
></div>
<div
  class="section color-{{ section.settings.color_scheme }} lookbook-gallery spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}{% if has_custom_bg %} background-color: {{ custom_bg }};{% endif %}"
>
  {%- if section.settings.title_visible and article.title != blank -%}
    <header class="lookbook-gallery__header" style="--gallery-max-width: {{ section.settings.max_width }}px;">
      <h1 class="lookbook-gallery__title">{{ article.title }}</h1>
      {%- if section.settings.show_date -%}
        <time class="lookbook-gallery__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %Y' }}
        </time>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div
    class="lookbook-gallery__photos"
    style="--gallery-gap: {{ section.settings.gap }}px; --gallery-radius: {{ section.settings.border_radius }}px; --gallery-border-width: {{ section.settings.border_width }}px; --gallery-border-color: {{ section.settings.border_color }}; --gallery-max-width: {{ section.settings.max_width }}px;"
  >
    {%- assign photos = article.metafields.custom.photos.value -%}
    {%- if photos != blank -%}
      {%- for photo in photos -%}
        {%- liquid
          assign loading_attr = 'lazy'
          assign fetch_priority = 'auto'
          if forloop.first
            assign loading_attr = 'eager'
            assign fetch_priority = 'high'
          endif
        -%}
        <figure class="lookbook-gallery__figure">
          {{
            photo
            | image_url: width: 2400
            | image_tag:
              widths: widths,
              alt: photo.alt | default: article.title,
              class: 'lookbook-gallery__image',
              sizes: '(min-width: 750px) 900px, 100vw',
              loading: loading_attr,
              fetchpriority: fetch_priority
          }}
        </figure>
      {%- endfor -%}
    {%- else -%}
      <figure class="lookbook-gallery__figure lookbook-gallery__figure--empty">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-gallery__placeholder-svg' }}
      </figure>
    {%- endif -%}
  </div>

  {%- if section.settings.show_back_link -%}
    <div class="lookbook-gallery__back" style="--gallery-max-width: {{ section.settings.max_width }}px;">
      <a href="{{ blog.url }}" class="lookbook-gallery__back-link">&larr; Back to {{ blog.title }}</a>
    </div>
  {%- endif -%}
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .lookbook-gallery__header {
    text-align: center;
    padding-block-end: clamp(32px, 5vw, 72px);
    max-width: var(--gallery-max-width, 900px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .lookbook-gallery__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }

  .lookbook-gallery__date {
    display: block;
    margin-block-start: 8px;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .lookbook-gallery__photos {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gallery-gap, 12px);
    max-width: var(--gallery-max-width, 900px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
    box-sizing: border-box;
  }

  .lookbook-gallery__figure {
    margin: 0;
    border-radius: var(--gallery-radius, 16px);
    overflow: hidden;
    border: var(--gallery-border-width, 3px) solid var(--gallery-border-color, #ffffff);
    background: rgba(from var(--color-foreground) r g b / 0.04);
  }

  /* Desktop pattern (repeats every 6 photos):
     slot 1  → full-width banner
     slot 2,3 → half-width landscapes
     slot 4,5,6 → third-width portraits                              */
  .lookbook-gallery__figure:nth-child(6n + 1) {
    grid-column: span 6;
    aspect-ratio: 2 / 1;
  }

  .lookbook-gallery__figure:nth-child(6n + 2),
  .lookbook-gallery__figure:nth-child(6n + 3) {
    grid-column: span 3;
    aspect-ratio: 4 / 3;
  }

  .lookbook-gallery__figure:nth-child(6n + 4),
  .lookbook-gallery__figure:nth-child(6n + 5),
  .lookbook-gallery__figure:nth-child(6n + 6) {
    grid-column: span 2;
    aspect-ratio: 3 / 4;
  }

  .lookbook-gallery__figure--empty {
    grid-column: span 6;
    aspect-ratio: 2 / 1;
  }

  .lookbook-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lookbook-gallery__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile pattern (2 cols): banner → 2 portraits → 2 portraits → banner */
  @media (max-width: 749px) {
    .lookbook-gallery__photos {
      grid-template-columns: repeat(2, 1fr);
    }

    .lookbook-gallery__figure:nth-child(6n + 1) {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }

    .lookbook-gallery__figure:nth-child(6n + 2),
    .lookbook-gallery__figure:nth-child(6n + 3),
    .lookbook-gallery__figure:nth-child(6n + 4),
    .lookbook-gallery__figure:nth-child(6n + 5) {
      grid-column: span 1;
      aspect-ratio: 3 / 4;
    }

    .lookbook-gallery__figure:nth-child(6n + 6) {
      grid-column: span 2;
      aspect-ratio: 3 / 2;
    }

    .lookbook-gallery__figure--empty {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
  }

  .lookbook-gallery__back {
    text-align: center;
    padding-block-start: clamp(32px, 5vw, 72px);
    max-width: var(--gallery-max-width, 900px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .lookbook-gallery__back-link {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .lookbook-gallery__back-link:hover {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook gallery",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "title_visible",
      "label": "Show article title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show back link",
      "default": true
    },
    {
      "type": "header",
      "content": "Gallery style"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900,
      "info": "The section content is centered and capped at this width on desktop."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between photos",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Overrides the color scheme background. Leave unset to use the color scheme."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Lookbook gallery",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
