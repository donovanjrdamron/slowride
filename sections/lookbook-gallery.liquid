{% liquid
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1800, 2000, 2500, 3000, 3840'
  assign custom_bg = section.settings.background_color
  assign has_custom_bg = false
  if custom_bg != blank and custom_bg != 'rgba(0,0,0,0)'
    assign has_custom_bg = true
  endif
%}

<div
  class="section-background color-{{ section.settings.color_scheme }}"
  {% if has_custom_bg %}style="background-color: {{ custom_bg }};"{% endif %}
></div>
<div
  class="section color-{{ section.settings.color_scheme }} lookbook-gallery spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}{% if has_custom_bg %} background-color: {{ custom_bg }};{% endif %}"
>
  {%- if section.settings.title_visible and article.title != blank -%}
    <header class="lookbook-gallery__header" style="--gallery-max-width: {{ section.settings.max_width }}px;">
      <h1 class="lookbook-gallery__title">{{ article.title }}</h1>
      {%- if section.settings.show_date -%}
        <time class="lookbook-gallery__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %Y' }}
        </time>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div
    class="lookbook-gallery__photos"
    style="--gallery-gap: {{ section.settings.gap }}px; --gallery-radius: {{ section.settings.border_radius }}px; --gallery-border-width: {{ section.settings.border_width }}px; --gallery-border-color: {{ section.settings.border_color }}; --gallery-max-width: {{ section.settings.max_width }}px;"
  >
    {%- assign photos = article.metafields.custom.photos.value -%}
    {%- if photos != blank -%}
      {%- liquid
        assign target_row_h = 320.0
        assign packing_w = section.settings.max_width | minus: 64 | times: 1.0
        assign target_ratio_sum = packing_w | divided_by: target_row_h
        assign current_ratio_sum = 0.0
      -%}
      {%- capture row_buffer %}{% endcapture -%}
      {%- for photo in photos -%}
        {%- liquid
          # Resolve the underlying image object so width/height/alt work
          # whether the metafield is an image_reference or file_reference.
          assign img = photo
          if photo.image != blank
            assign img = photo.image
          elsif photo.preview_image != blank
            assign img = photo.preview_image
          endif

          assign w = img.width
          if w == blank or w == 0
            assign w = photo.width
          endif
          if w == blank or w == 0
            assign w = 3
          endif
          assign h = img.height
          if h == blank or h == 0
            assign h = photo.height
          endif
          if h == blank or h == 0
            assign h = 4
          endif
          assign ratio = w | times: 1.0 | divided_by: h

          assign photo_alt = img.alt | default: photo.alt | default: article.title

          assign loading_attr = 'lazy'
          assign fetch_priority = 'auto'
          if forloop.first
            assign loading_attr = 'eager'
            assign fetch_priority = 'high'
          endif
        -%}
        {%- if current_ratio_sum >= target_ratio_sum -%}
          <div class="lookbook-gallery__row">{{ row_buffer }}</div>
          {%- capture row_buffer %}{% endcapture -%}
          {%- assign current_ratio_sum = 0.0 -%}
        {%- endif -%}
        {%- capture figure_html -%}
          <figure class="lookbook-gallery__figure" style="--ratio: {{ ratio }};">
            {{
              img
              | image_url: width: 2400
              | image_tag:
                widths: widths,
                alt: photo_alt,
                class: 'lookbook-gallery__image',
                sizes: '(min-width: 750px) 500px, 50vw',
                loading: loading_attr,
                fetchpriority: fetch_priority
            }}
          </figure>
        {%- endcapture -%}
        {%- capture row_buffer -%}{{ row_buffer }}{{ figure_html }}{%- endcapture -%}
        {%- assign current_ratio_sum = current_ratio_sum | plus: ratio -%}
      {%- endfor -%}
      {%- if row_buffer != blank -%}
        <div class="lookbook-gallery__row lookbook-gallery__row--last">{{ row_buffer }}</div>
      {%- endif -%}
    {%- else -%}
      <div class="lookbook-gallery__row lookbook-gallery__row--last">
        <figure class="lookbook-gallery__figure lookbook-gallery__figure--empty" style="--ratio: 1.5;">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-gallery__placeholder-svg' }}
        </figure>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_back_link -%}
    <div class="lookbook-gallery__back" style="--gallery-max-width: {{ section.settings.max_width }}px;">
      <a href="{{ blog.url }}" class="lookbook-gallery__back-link">&larr; Back to {{ blog.title }}</a>
    </div>
  {%- endif -%}
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .lookbook-gallery__header {
    text-align: center;
    padding-block-end: clamp(32px, 5vw, 72px);
    max-width: var(--gallery-max-width, 900px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .lookbook-gallery__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }

  .lookbook-gallery__date {
    display: block;
    margin-block-start: 8px;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* Justified rows. Each row is its own flex container. Within a row,
     figures use flex-basis: 0 + flex-grow: ratio so widths divide
     proportionally to aspect ratios, and aspect-ratio: ratio makes every
     figure's height match the others. No cropping; true ratios preserved. */
  .lookbook-gallery__photos {
    --row-h: 320px;
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap, 12px);
    max-width: var(--gallery-max-width, 900px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
    box-sizing: border-box;
  }

  .lookbook-gallery__row {
    display: flex;
    align-items: flex-start;
    gap: var(--gallery-gap, 12px);
    width: 100%;
    min-width: 0;
  }

  .lookbook-gallery__figure {
    margin: 0;
    border-radius: var(--gallery-radius, 16px);
    overflow: hidden;
    border: var(--gallery-border-width, 3px) solid var(--gallery-border-color, #ffffff);
    background: rgba(from var(--color-foreground) r g b / 0.04);
    box-sizing: border-box;
    flex-basis: 0;
    flex-grow: var(--ratio, 0.75);
    flex-shrink: 1;
    min-width: 0;
    aspect-ratio: var(--ratio, 0.75);
  }

  /* Last row: figures at natural size so a lonely last photo doesn't
     stretch to full-width. Wrap allows graceful overflow on mobile. */
  .lookbook-gallery__row--last {
    flex-wrap: wrap;
  }
  .lookbook-gallery__row--last .lookbook-gallery__figure {
    flex: 0 1 auto;
    width: calc(var(--ratio, 0.75) * var(--row-h));
    height: var(--row-h);
    max-width: 100%;
    aspect-ratio: auto;
  }

  .lookbook-gallery__figure > .lookbook-gallery__image,
  .lookbook-gallery__figure > .lookbook-gallery__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 749px) {
    .lookbook-gallery__photos {
      --row-h: 200px;
    }
  }

  .lookbook-gallery__back {
    text-align: center;
    padding-block-start: clamp(32px, 5vw, 72px);
    max-width: var(--gallery-max-width, 900px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .lookbook-gallery__back-link {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .lookbook-gallery__back-link:hover {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook gallery",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "title_visible",
      "label": "Show article title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show back link",
      "default": true
    },
    {
      "type": "header",
      "content": "Gallery style"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900,
      "info": "The section content is centered and capped at this width on desktop."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between photos",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Overrides the color scheme background. Leave unset to use the color scheme."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Lookbook gallery",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
